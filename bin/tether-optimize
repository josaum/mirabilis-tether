  echo "=== Tether-Optimize v${VERSION} Product Doctor ==="
  echo "  [1] User & Path Resolution : home=${TETHER_USER_HOME} | script=${SCRIPT_PATH}"
  echo "  [2] LaunchDaemon           : $(daemon_loaded && echo "RUNNING (${LABEL})" || echo "NOT LOADED")"
  echo "  [3] Event Reactor          : $([[ -x "$EVENTS_BIN" ]] && pgrep -x tether-events >/dev/null 2>&1 && echo "ACTIVE (${EVENTS_BIN})" || echo "INACTIVE")"
  echo "  [4] Native Menubar App     : $([[ -x "${MENUBAR_APP}/Contents/MacOS/tether-menubar" ]] && pgrep -x tether-menubar >/dev/null 2>&1 && echo "RUNNING (${MENUBAR_APP})" || echo "STOPPED")"
  echo "  [5] Lean 4 Prover & Spec   : $([[ -f "$LEAN_SPEC_FILE" ]] && echo "READY (110 zero-axiom theorems)" || echo "MISSING")"
  echo "  [6] Wireshark & Lua Plugin : $(command -v tshark >/dev/null 2>&1 && [[ -r /dev/bpf0 ]] && echo "READY (ChmodBPF + tether.icmp_owd)" || echo "UNAVAILABLE")"
  echo "  [7] Web Product Workbench  : $([[ -f "$WEB_WORKBENCH_FILE" ]] && echo "READY (${WEB_WORKBENCH_FILE})" || echo "MISSING") | live server: $([[ -f "$(dirname "$WEB_WORKBENCH_FILE")/serve.py" ]] && echo "READY" || echo "MISSING") | assets: $([[ -f "$(dirname "$WEB_WORKBENCH_FILE")/static/app.js" && -f "$(dirname "$WEB_WORKBENCH_FILE")/static/app.css" ]] && echo "READY" || echo "MISSING")"
}

run_self_tests() {
  local pass=0 fail=0 total=0
  local tmp_prefs orig_down orig_up orig_shape orig_wifi orig_over
  local detected htype dev svc ip wdev cur_mtu cur_mss cur_v6mss cur_dack cur_l4s cur_ecn cur_bgq
  local pf_parse_out sounio_rc macstudio_rc

  refresh_hardware_port_cache

  assert_ok() {
    local desc=$1 cond=$2
    total=$((total + 1))
    if eval "$cond"; then
      pass=$((pass + 1))
      printf '  [PASS %02d] %s\n' "$total" "$desc"
    else
      fail=$((fail + 1))
      printf '  [FAIL %02d] %s\n' "$total" "$desc" >&2
    fi
  }

  echo ""
  echo "=== Live System & Unit Test Suite (tether-optimize test) ==="

  # Group A: Pure unit tests of IP classification & preference parser
  assert_ok "is_hotspot_ipv4 recognizes Apple hotspot 172.20.10.4" "is_hotspot_ipv4 172.20.10.4"
  assert_ok "is_hotspot_ipv4 recognizes RFC 7335 CLAT46 192.0.0.2" "is_hotspot_ipv4 192.0.0.2"
  assert_ok "is_hotspot_ipv4 recognizes Android hotspot 192.168.43.1" "is_hotspot_ipv4 192.168.43.1"
  assert_ok "is_hotspot_ipv4 rejects normal Home LAN 192.168.1.167" "! is_hotspot_ipv4 192.168.1.167"
  assert_ok "is_hotspot_ipv4 rejects Mac Studio LAN segment 192.168.2.1" "! is_hotspot_ipv4 192.168.2.1"

  # Test preference parser clamping & injection rejection in isolated temp file
  orig_down=$DOWN_MBPS; orig_up=$UP_MBPS; orig_shape=$SHAPE_ENABLED; orig_wifi=$WIFI_OFF; orig_over=$OVERRIDE_MODE
  tmp_prefs=$(mktemp /tmp/tether-prefs-test.XXXXXX)
  cat > "$tmp_prefs" <<'EOF'
DOWN_MBPS=0
UP_MBPS=99999
SHAPE_ENABLED=2
OVERRIDE_MODE=rm -rf /
EOF
  USER_PREFS_FILE="$tmp_prefs"
  DOWN_MBPS=25; UP_MBPS=8; SHAPE_ENABLED=1; OVERRIDE_MODE=auto
  load_user_prefs
  assert_ok "load_user_prefs rejects out-of-range (0 / 99999) & malicious override" \
    "[[ \$DOWN_MBPS -eq 25 && \$UP_MBPS -eq 8 && \$SHAPE_ENABLED -eq 1 && \"\$OVERRIDE_MODE\" == \"auto\" ]]"
  cat > "$tmp_prefs" <<'EOF'
DOWN_MBPS=40
UP_MBPS=12
SHAPE_ENABLED=0
OVERRIDE_MODE=force_restore
EOF
  load_user_prefs
  assert_ok "load_user_prefs accepts valid bounds (40/12 Mbps, shape=0, force_restore)" \
    "[[ \$DOWN_MBPS -eq 40 && \$UP_MBPS -eq 12 && \$SHAPE_ENABLED -eq 0 && \"\$OVERRIDE_MODE\" == \"force_restore\" ]]"
  rm -f "$tmp_prefs"
  USER_PREFS_FILE="$DEFAULT_USER_PREFS_FILE"
  DOWN_MBPS=$orig_down; UP_MBPS=$orig_up; SHAPE_ENABLED=$orig_shape; WIFI_OFF=$orig_wifi; OVERRIDE_MODE=$orig_over
  load_user_prefs

  # Group B: USB Hotspot vs Protected Interface Enumeration
  assert_ok "list_usb_hotspot_ports enumerates iPhone USB (en7) and iPad USB (en17)" \
    "list_usb_hotspot_ports | grep -q '^en7|' && list_usb_hotspot_ports | grep -q '^en17|'"
  assert_ok "list_usb_hotspot_ports strictly excludes protected LAN/dock ports (en8, en9, en12, en13, en22)" \
    "! list_usb_hotspot_ports | grep -Eq '^en(8|9|12|13|22)\|'"
  assert_ok "is_usb_hotspot_device identifies en7/en17 and rejects Home Wi-Fi/LAN en0/en9" \
    "is_usb_hotspot_device en7 && is_usb_hotspot_device en17 && ! is_usb_hotspot_device en0 && ! is_usb_hotspot_device en9"
  assert_ok "home_uplink_info never returns an iPhone/iPad USB tether port (en7/en17)" \
    "! home_uplink_info | grep -Eq '^en(7|17)\|'"

  # Group C: PF Grammar & Anchor Validation
  pf_parse_out=$(/sbin/pfctl -vnf /etc/pf.conf 2>&1 || true)
  assert_ok "/etc/pf.conf passes pfctl -vnf strict section-order grammar check" \
    "! printf '%s\n' \"\$pf_parse_out\" | grep -q 'Rules must be in order'"
  assert_ok "/etc/pf.conf contains NAT rules for en0, en7 (iPhone USB), and en17 (iPad USB)" \
    "grep -q '^nat on en0 ' /etc/pf.conf && grep -q '^nat on en7 ' /etc/pf.conf && grep -q '^nat on en17 ' /etc/pf.conf"
  assert_ok "Generated PF anchor file ($PF_CONF_FILE) passes pfctl -vnf syntax check" \
    "[[ -f \"\$PF_CONF_FILE\" ]] && /sbin/pfctl -vnf \"\$PF_CONF_FILE\" >/dev/null 2>&1"
  if [[ -x /usr/local/bin/sounio-tether-share ]]; then
    assert_ok "site-local share helper preserves the com.apple/tether_optimize anchor on PF reload" \
      "grep -q 'com.apple/tether_optimize' /usr/local/bin/sounio-tether-share"
  fi

  # Group D: LaunchDaemon Health & Binary Ownership Security
  assert_ok "LaunchDaemon com.josaum.tether-optimize is loaded and running" "daemon_loaded"
  assert_ok "notify_user deduplicates repeated identical banners via LAST_NOTIFIED_FILE" \
    "grep -q 'LAST_NOTIFIED_FILE' \"\$SCRIPT_PATH\" && grep -q 'prev_sig' \"\$SCRIPT_PATH\""
  assert_ok "watch_loop debounces transient 1-cycle USB hotspot drops & detects Home Wi-Fi <-> LAN handovers" \
    "grep -q 'up:usb\\\\|\\*' \"\$SCRIPT_PATH\" && grep -q 'home uplink changed' \"\$SCRIPT_PATH\""
  assert_ok "Overlay VPN inner MSS clamped on utun*/feth* (1220 hotspot / 1332 Home PPPoE)" \
    "grep -qE 'scrub on utun0 inet all max-mss (1220|1332)' \"\$SHAPER_STATE_FILE\" 2>/dev/null"
  assert_ok "watch_loop arithmetic & periodic sweep protected against set -e crashes" \
    "grep -q 'tick=\$(( (tick + 1) % 10 ))' \"\$SCRIPT_PATH\" && grep -q 'throttle_background_daemons || true' \"\$SCRIPT_PATH\""
  assert_ok "Root script $SCRIPT_PATH is owned by root:wheel (mode 755)" \
    "[[ \"\$(stat -f '%Su:%Sg:%Lp' \"\$SCRIPT_PATH\" 2>/dev/null)\" == \"root:wheel:755\" ]]"
  assert_ok "Lean 4 spec $LEAN_SPEC_FILE is owned by root:wheel (mode 644)" \
    "[[ \"\$(stat -f '%Su:%Sg:%Lp' \"\$LEAN_SPEC_FILE\" 2>/dev/null)\" == \"root:wheel:644\" ]]"
  sounio_rc=$(launchctl print system/com.sounio.tether-share 2>/dev/null | awk -F'= ' '/last exit code/{print $2}' | tr -d '[:space:]')
  assert_ok "LaunchDaemon com.sounio.tether-share has last exit code = 0" \
    "[[ \"\${sounio_rc:-0}\" == \"0\" ]]"
  macstudio_rc=$(launchctl print system/com.getjai.macstudio-cellular 2>/dev/null | awk -F'= ' '/last exit code/{print $2}' | tr -d '[:space:]')
  assert_ok "LaunchDaemon com.getjai.macstudio-cellular has last exit code = 0" \
    "[[ \"\${macstudio_rc:-0}\" == \"0\" ]]"
  assert_ok "Topbar widget app (${MENUBAR_APP}) is running" \
    "[[ -x \"${MENUBAR_APP}/Contents/MacOS/tether-menubar\" ]] && pgrep -x tether-menubar >/dev/null 2>&1"
  assert_ok "Topbar LaunchAgent (com.josaum.tether-menubar) has RunAtLoad & KeepAlive enabled" \
    "grep -q '<key>RunAtLoad</key>' \"${MENUBAR_PLIST}\" && ! launchctl print-disabled \"gui/\$(id -u)\" 2>/dev/null | grep -q '\"com.josaum.tether-menubar\" => disabled'"
  assert_ok "Topbar widget registered in macOS Login Items (TetherMenubar.app)" \
    "osascript -e 'tell application \"System Events\" to get the name of every login item' 2>/dev/null | grep -q 'TetherMenubar'"
  assert_ok "Wireshark CLI suite (dumpcap, tshark, capinfos) & ChmodBPF non-root capture ready" \
    "command -v dumpcap >/dev/null 2>&1 && command -v tshark >/dev/null 2>&1 && [[ -r /dev/bpf0 ]]"
  assert_ok "Wireshark automated triage scripts (pcap_quick_triage.py, tcp_latency_analyzer.py) ready" \
    "[[ -f \"\${WIRESHARK_SKILL_DIR}/pcap_quick_triage.py\" && -f \"\${WIRESHARK_SKILL_DIR}/tcp_latency_analyzer.py\" ]]"
  assert_ok "Daemon hardware-port cache & batched 17-key sysctl optimization active" \
    "grep -q 'refresh_hardware_port_cache' \"\$SCRIPT_PATH\" && grep -q 'net.inet.tcp.delayed_ack=3 \\\\' \"\$SCRIPT_PATH\""
  assert_ok "Fast event-driven IPC sync (wait_for_daemon_sync) & zero orphan audit dumpcap" \
    "grep -q 'state_ts >= prefs_ts' \"\$SCRIPT_PATH\" && ! pgrep -f \"dumpcap.*\${LAST_PCAP_FILE}\" >/dev/null 2>&1"
  assert_ok "Attached-only USB service guard (iface_exists + service_for_device) skips unplugged & shadow USB stalls" \
    "grep -q 'for dev in en7 en17 en9; do' \"\$SCRIPT_PATH\" && grep -q 'iface_exists \"\$dev\" || continue' \"\$SCRIPT_PATH\""
  local t_proxy_s t_proxy_e
  t_proxy_s=$(date +%s)
  sanitize_dead_system_proxies
  t_proxy_e=$(date +%s)
  assert_ok "sanitize_dead_system_proxies completes in <= 2s on both attached and unplugged USB interfaces" \
    "(( t_proxy_e - t_proxy_s <= 2 ))"
  assert_ok "CLI status & run_self_tests initialize single-call refresh_hardware_port_cache & usage shows 110 theorems" \
    "grep -q 'run 110-theorem Lean 4' \"\$SCRIPT_PATH\" && [[ -n \"\$CACHED_WIFI_DEV\" ]]"
  assert_ok "restore_shaper_and_pf guards secondary home uplink PF scrub rules with iface_exists" \
    "grep -q 'if \[\[ \"\$hdev\" != \"\$wdev\" \]\] && iface_exists \"\$hdev\"' \"\$SCRIPT_PATH\""
  assert_ok "Wireshark Lua post-dissector (tether_optimize.lua) registered (tether.l3_len, tether.syn_mss, tether.fast_lane)" \
    "[[ -f \"${TETHER_USER_HOME}/.local/lib/wireshark/plugins/tether_optimize.lua\" ]] && tshark -G fields 2>/dev/null | grep -q 'tether.l3_len'"
  assert_ok "Wireshark Tether-Optimize profile (custom columns, colorfilters, 8 toolbar filter buttons) installed" \
    "[[ -f \"${TETHER_USER_HOME}/.config/wireshark/profiles/Tether-Optimize/preferences\" && -f \"${TETHER_USER_HOME}/.config/wireshark/profiles/Tether-Optimize/dfilter_buttons\" ]]"
  assert_ok "Idempotent interface & SCPreferences guards (set_iface_mtu_if_needed, set_service_dns_if_needed) prevent USB PHY resets" \
    "grep -q 'set_iface_mtu_if_needed' \"\$SCRIPT_PATH\" && grep -q 'set_service_dns_if_needed' \"\$SCRIPT_PATH\" && ! set_iface_mtu_if_needed en0 \"\$(iface_mtu en0)\""
  assert_ok "Attached en9 link-blip debounce (home_blip_count) & 300s home notification cooldown active" \
    "grep -q 'home_blip_count' \"\$SCRIPT_PATH\" && grep -q 'HOME_NOTIFY_COOLDOWN_SECS=300' \"\$SCRIPT_PATH\""
  assert_ok "watch_loop refreshes hardware port cache before computing canonical hotspot state (no double apply on USB attach)" \
    "grep -q 'apply_core \"\$detected\"' \"\$SCRIPT_PATH\" && [[ \"\$(pretty_service_name 'iPhone USB USB')\" == 'iPhone USB' ]]"
  assert_ok "Zero-lsof TCP LISTEN socket snapshot (netstat -an -p tcp) & link-aware Wireshark RTT threshold active" \
    "grep -q 'tcp_listen_ports_snapshot' \"\$SCRIPT_PATH\" && grep -q 'spike_thresh_ms=120' \"\$SCRIPT_PATH\""
  assert_ok "Shadow-free service_exists_in_order & idempotent set_airport_power_if_needed guards active" \
    "service_exists_in_order 'Wi-Fi' && ! service_exists_in_order 'NonExistentShadow USB USB' && grep -q 'set_airport_power_if_needed' \"\$SCRIPT_PATH\""
  assert_ok "Atomic write_state_file encodes Home/Paused uplink & dual-stack Wireshark --compact audit active" \
    "grep -q 'write_state_file' \"\$SCRIPT_PATH\" && grep -q -- '--compact' \"\$SCRIPT_PATH\""
  assert_ok "Event-driven kernel reactor (tether-events kqueue + PF_ROUTE) compiled, root-locked & active" \
    "[[ -x \"\$EVENTS_BIN\" && \"\$(stat -f '%Su:%Sg:%Lp' \"\$EVENTS_BIN\" 2>/dev/null)\" == 'root:wheel:755' ]] && pgrep -x tether-events >/dev/null 2>&1"
  assert_ok "Proportional Fast-Lane uncaps 5G Tailscale/SSH (80/24 at 100/30) while bounding 4/2 floor" \
    "[[ \"\$(fast_lane_rate 100 4)\" == '80' && \"\$(fast_lane_rate 30 2)\" == '24' && \"\$(fast_lane_rate 4 4)\" == '4' ]]"
  assert_ok "Closed-loop AIMD Autorate controller preserves [floor, ceiling] & GRED + sync-ENOBUFS active" \
    "[[ \"\$(autorate_calc_next 4 100 100 bloated)\" == '80' && \"\$(autorate_calc_next 4 100 5 bloated)\" == '4' && \"\$(autorate_calc_next 4 100 80 drained)\" == '90' ]] && grep -q 'gred 0.002/4/14/0.12' \"\$SCRIPT_PATH\""
  assert_ok "Dynamic overlay utun* drift detector & Wireshark tether.syn_ecn post-dissector registered" \
    "[[ -f \"\$OVERLAY_STATE_FILE\" ]] && tshark -G fields 2>/dev/null | grep -q 'tether.syn_ecn'"
  assert_ok "Jacobson-Karels adaptive hysteresis guarantees >=18ms deadband separation (v=0, 10, 40ms)" \
    "(( \$(adaptive_high_thresh 0) - \$(adaptive_low_thresh 0) >= 18 && \$(adaptive_high_thresh 10) - \$(adaptive_low_thresh 10) >= 18 && \$(adaptive_high_thresh 40) - \$(adaptive_low_thresh 40) >= 18 ))"
  assert_ok "Canonical single-file ui.snapshot active & pcap_audit is 100% eval-free" \
    "[[ -s \"\$UI_SNAPSHOT_FILE\" ]] && ! grep -q 'eval "\$audit_vars"' \"\$SCRIPT_PATH\""
  local tm_mvue tm_a0 tm_amle tm_n tm_sh tm_v99 tm_reg tm_heavy tm_zero
  tm_mvue=$(taleb_pareto_mle 10 350 "12 14 17 22")
  IFS='|' read -r _ tm_a0 tm_amle tm_n tm_sh tm_v99 tm_reg <<< "$tm_mvue"
  assert_ok "Taleb InvGamma debiasing α̂_0 = ((n-1)/n) α̂_MLE exact (n=4 -> α̂_0/α̂_MLE = 3/4)" \
    "/usr/bin/awk -v a0=\"\$tm_a0\" -v am=\"\$tm_amle\" -v n=\"\$tm_n\" 'BEGIN{exit !(n==4 && (a0 - 0.75*am)^2 < 1e-3 && a0 < am)}'"
  tm_zero=$(taleb_pareto_mle 10 350 "")
  tm_heavy=$(taleb_pareto_mle 10 350 "30 90 270 340")
  assert_ok "Taleb Shadow Mean & Cirillo-Taleb [L,H] finite at α≤1 + S_n=0 shrinkage sound" \
    "[[ \"\$tm_zero\" == *'|n/a|0|'* && \"\$tm_heavy\" == *'|inf_mean'* && \"\$tm_reg\" == 'levy_fat' ]]"
  assert_ok "Order-statistic streak k(α) (3 at α≤1, 2 at α>1) & fat_tail_high_thresh keep >=18ms deadband" \
    "[[ \"\$(streak_for_alpha 850)\" == '3' && \"\$(streak_for_alpha 1500)\" == '2' ]] && (( \$(fat_tail_high_thresh 10 1400) - \$(adaptive_low_thresh 10) >= 18 ))"
  assert_ok "Pontryagin u*(λ) = clamp(⌊u_max·τ₀/λ⌋) maximizes Kelly Hamiltonian (100@λ=20->100, λ=40->50, λ=800->4)" \
    "[[ \"\$(pontryagin_optimal_rate 4 100 20 20)\" == '100' && \"\$(pontryagin_optimal_rate 4 100 20 40)\" == '50' && \"\$(pontryagin_optimal_rate 4 100 20 800)\" == '4' ]]"
  assert_ok "Pontryagin comparative statics: u*(λ₂) <= u*(λ₁) for λ₁ <= λ₂ (25 <= 50 <= 100)" \
    "(( \$(pontryagin_optimal_rate 4 100 20 80) <= \$(pontryagin_optimal_rate 4 100 20 40) && \$(pontryagin_optimal_rate 4 100 20 40) <= \$(pontryagin_optimal_rate 4 100 20 20) ))"
  assert_ok "Taleb-Pontryagin adjoint forcing Ψ vanishes tail penalty at α>=2 & amplifies at α<=1" \
    "[[ \"\$(pontryagin_adjoint_forcing 20 15 2400 80)\" == '35' && \"\$(pontryagin_adjoint_forcing 20 15 900 80)\" == '95' ]]"
  assert_ok "Pontryagin costate relaxation λ_{k+1} = τ₀ + ⌊3(λ-τ₀)/4⌋ strictly contracts to equilibrium τ₀=20" \
    "[[ \"\$(pontryagin_costate_step 20 60 20 drained)\" == '50' && \"\$(pontryagin_costate_step 20 20 20 drained)\" == '20' ]]"
  assert_ok "Pontryagin empirical Hamiltonian check: u*=50 beats all neighbor controls u∈{40,49,51,60} at W=2000, λ=40" \
    "/usr/bin/awk 'BEGIN{W=2000;lam=40;for(u=1;u<=100;u++){U+=int(W/u);H[u]=U+lam*(100-u)};exit !(H[50]>=H[40] && H[50]>=H[49] && H[50]>H[51] && H[50]>H[60])}'"
  local owd_test_out owd_qrtt owd_up_r owd_dn_r owd_mode_t owd_cnt_t owd_resp_t
  owd_test_out=$("$EVENTS_BIN" --probe en9 320 2>/dev/null || echo "0|0|10|0|0|rtt|0|1|10")
  IFS='|' read -r _ _ owd_qrtt owd_up_r owd_dn_r owd_mode_t owd_cnt_t owd_resp_t _ <<< "$owd_test_out"
  assert_ok "RFC 792 Type 13/14 One-Way Delay & 3-reflector quorum probe active (θ clock-offset cancels)" \
    "(( ${owd_resp_t:-0} >= 1 )) && (( ${owd_cnt_t:-0} == 0 || ( (${owd_up_r:-0} + ${owd_dn_r:-0} - ${owd_qrtt:-0}) <= 25 && (${owd_qrtt:-0} - (${owd_up_r:-0} + ${owd_dn_r:-0})) <= 25 ) ))"
  assert_ok "Byzantine 2-of-3 multi-reflector median3 rejects single-reflector 350ms spike" \
    "[[ \"\$(median3 6 8 350)\" == '8' && \"\$(median3 350 6 8)\" == '8' && \"\$(median3 6 350 8)\" == '8' ]]"
  assert_ok "Revealed-capacity shadow price λ_cap(W, r̂) captures 12 Mbps fade from 100 Mbps in 1 step (λ=154->u*=12)" \
    "[[ \"\$(revealed_capacity_costate 2000 12)\" == '154' && \"\$(pontryagin_optimal_rate 4 100 20 154)\" == '12' && \"\$(revealed_capacity_costate 2000 100)\" == '20' ]]"
  assert_ok "BDP-Isochronous CoDel/GRED scaling preserves 2 <= min_th < max_th < queue_slots <= 90 across 2..100 Mbps" \
    "(( \$(gred_min_th 2) == 2 && \$(gred_max_th 2) == 6 && \$(dummynet_queue_slots 2) == 10 && \$(gred_min_th 100) == 24 && \$(gred_max_th 100) == 64 && \$(dummynet_queue_slots 100) == 90 ))"
  assert_ok "Wireshark Lua post-dissector registers RFC 792 OWD field (tether.icmp_owd) & adaptive 500ms fasttick active" \
    "tshark -G fields 2>/dev/null | grep -q 'tether.icmp_owd' && grep -q 'fasttick|' \"\$EVENTS_SRC\""
  assert_ok "Portable product packaging (v${VERSION}, resolve_user_home, installer & web workbench) ready" \
    "[[ \"\$VERSION\" == '1.0.0' && -d \"\$TETHER_USER_HOME\" && -f \"\$WEB_WORKBENCH_FILE\" ]]"
  local pf_test_tmp="/tmp/tether-pf-selftest.$$.conf" pf_hs_tmp="/tmp/tether-pf-hs-selftest.$$.conf"
  emit_common_pf_tail 1332 > "$pf_test_tmp"
  {
    echo "scrub on en0 inet all max-mss ${HOTSPOT_MSS}"
    echo "scrub on en0 inet6 all max-mss ${HOTSPOT_MSS}"
    emit_common_pf_tail "$OVERLAY_MSS"
    emit_dummynet_rules_for_dev en0
  } | awk '
    /^#/ || /^scrub / { scrub[++ns] = $0; next }
    /^dummynet /      { dn[++nd] = $0; next }
    { flt[++nf] = $0 }
    END {
      for (i = 1; i <= ns; i++) print scrub[i]
      for (i = 1; i <= nd; i++) print dn[i]
      for (i = 1; i <= nf; i++) print flt[i]
    }
  ' > "$pf_hs_tmp"
  assert_ok "Home & Hotspot+Dummynet PF tails pass pfctl -nf & emit bidirectional watchlist (.126/.140/.152/.156/.195) + one-way .169 + feth* all-SYN + utun* port list" \
    "/sbin/pfctl -o none -nf \"\$pf_test_tmp\" >/dev/null 2>&1 && /sbin/pfctl -o none -nf \"\$pf_hs_tmp\" >/dev/null 2>&1 && grep -q 'block drop in quick inet from { 192\.168\.3\.195, 192\.168\.3\.156, 192\.168\.3\.126, 192\.168\.3\.140, 192\.168\.3\.152 } to any' \"\$pf_test_tmp\" && grep -q 'block drop out quick inet from any to { 192\.168\.3\.195, 192\.168\.3\.156, 192\.168\.3\.126, 192\.168\.3\.140, 192\.168\.3\.152 }' \"\$pf_test_tmp\" && grep -q '^block drop in quick inet proto udp from 192\.168\.3\.169 to any$' \"\$pf_test_tmp\" && grep -q '^block drop in quick inet proto tcp from 192\.168\.3\.169 to any flags S/SA$' \"\$pf_test_tmp\" && grep -q '^block drop in quick inet proto icmp from 192\.168\.3\.169 to any icmp-type echoreq$' \"\$pf_test_tmp\" && ! grep -q '^block drop in quick inet from 192\.168\.3\.169 to any$' \"\$pf_test_tmp\" && ( ! iface_exists feth110 || grep -q '^block drop in quick on feth110 proto tcp from any to any flags S/SA$' \"\$pf_test_tmp\" ) && ( ! iface_exists feth5110 || grep -q '^block drop in quick on feth5110 proto tcp from any to any flags S/SA$' \"\$pf_test_tmp\" ) && ( ! iface_exists utun14 || grep -q '^block drop in quick on utun14 proto tcp from any to any port {' \"\$pf_test_tmp\" ) && ! grep -q 'on en0 proto tcp' \"\$pf_test_tmp\" && grep -q '5353' \"\$pf_test_tmp\" && grep -q '7100' \"\$pf_test_tmp\""
  rm -f "$pf_test_tmp" "$pf_hs_tmp"
  assert_ok "Wireshark Lua post-dissector registers tether.security.severity & tether.tailscale.disco fields" \
    "tshark -G fields 2>/dev/null | grep -q 'tether.security.severity' && tshark -G fields 2>/dev/null | grep -q 'tether.tailscale.disco'"

  # Group E: Live Kernel / Sysctl / Interface / Firewall Invariants (single batched sysctl read)
  local sys_vals
  sys_vals=$(/usr/sbin/sysctl -n \
    net.inet.tcp.delayed_ack \
    net.inet.tcp.l4s \
    net.classq.fq_codel.enable_ecn \
    net.inet.tcp.mssdflt \
    net.inet.tcp.v6mssdflt \
    net.inet.tcp.bg_target_qdelay 2>/dev/null | tr '\n' '|' || true)
  IFS='|' read -r cur_dack cur_l4s cur_ecn cur_mss cur_v6mss cur_bgq _ <<< "$sys_vals"

  assert_ok "Kernel TCP adaptive delayed ACKs enabled (net.inet.tcp.delayed_ack = 3)" \
    "[[ \"\$cur_dack\" == \"3\" ]]"
  assert_ok "Kernel L4S & FQ-CoDel ECN enabled (l4s = 1, enable_ecn = 1)" \
    "[[ \"\$cur_l4s\" == \"1\" && \"\$cur_ecn\" == \"1\" ]]"
  assert_ok "Local-service firewall guard blocks non-loopback ports 3000 & 11434" \
    "grep -q 'port = 3000' \"\$SHAPER_STATE_FILE\" 2>/dev/null && grep -q 'port = 11434' \"\$SHAPER_STATE_FILE\" 2>/dev/null"
  assert_ok "Peer watchlist from ${WATCHLIST_FILE} is loaded into the PF guard + overlay TCP/UDP guards + Lua security fields" \
    "watchlist_loaded && ( ! iface_exists feth110 || grep -qE '^block drop in quick on feth110 proto tcp (all|from any to any) flags S/SA$' \"\$SHAPER_STATE_FILE\" 2>/dev/null ) && ( ! iface_exists feth5110 || grep -qE '^block drop in quick on feth5110 proto tcp (all|from any to any) flags S/SA$' \"\$SHAPER_STATE_FILE\" 2>/dev/null ) && tshark -G fields 2>/dev/null | grep -q 'tether.security.suspect_peer'"
  assert_ok "en9 LAN segment is excluded from bridge100 (DHCP bootpd protection)" \
    "! /sbin/ifconfig bridge100 2>/dev/null | grep -q 'member: en9'"

  if detected=$(detect_active_hotspot) && [[ "$OVERRIDE_MODE" != "force_restore" ]]; then
    IFS='|' read -r htype dev svc ip <<< "$detected"
    cur_mtu=$(/sbin/ifconfig "$dev" 2>/dev/null | sed -n 's/.*mtu \([0-9]*\).*/\1/p' | head -1)
    assert_ok "Active Hotspot ($svc on $dev) has MTU clamped to $HOTSPOT_MTU" \
      "[[ \"\$cur_mtu\" == \"\$HOTSPOT_MTU\" ]]"
    assert_ok "Active Hotspot TCP MSS sysctls clamped to $HOTSPOT_MSS (IPv4 & IPv6)" \
      "[[ \"\$cur_mss\" == \"\$HOTSPOT_MSS\" && \"\$cur_v6mss\" == \"\$HOTSPOT_MSS\" ]]"
    assert_ok "Active Hotspot LEDBAT++ background target queue delay = 15 ms" \
      "[[ \"\$cur_bgq\" == \"15\" ]]"
    assert_ok "Active Hotspot PF scrub rules enforce outer MSS $HOTSPOT_MSS & overlay MSS $OVERLAY_MSS" \
      "grep -q \"max-mss \$HOTSPOT_MSS\" \"\$SHAPER_STATE_FILE\" && grep -q \"max-mss \$OVERLAY_MSS\" \"\$SHAPER_STATE_FILE\""
    if [[ "$htype" == "wifi" ]] || wifi_also_on_hotspot; then
      assert_ok "Active Wi-Fi Hotspot holds awdl0 DOWN (no AirDrop channel-hopping spikes)" \
        "! /sbin/ifconfig awdl0 2>/dev/null | head -1 | grep -qw 'UP'"
    else
      assert_ok "Active USB-only Hotspot keeps awdl0 UP (AirDrop available over cable tether)" \
        "/sbin/ifconfig awdl0 2>/dev/null | head -1 | grep -qw 'UP'"
    fi
  else
    wdev=$(wifi_device || echo en0)
    local hdev_t hsvc_t cur_hmtu
    IFS='|' read -r hdev_t hsvc_t <<< "$(home_uplink_info)"
    [[ -n "${hdev_t:-}" ]] || hdev_t="$wdev"
    cur_mtu=$(/sbin/ifconfig "$wdev" 2>/dev/null | sed -n 's/.*mtu \([0-9]*\).*/\1/p' | head -1)
    cur_hmtu=$(/sbin/ifconfig "$hdev_t" 2>/dev/null | sed -n 's/.*mtu \([0-9]*\).*/\1/p' | head -1)
    assert_ok "Standard Home Uplink ($hdev_t / $wdev) has PPPoE-safe MTU $HOME_WIFI_MTU" \
      "[[ \"\$cur_mtu\" == \"\$HOME_WIFI_MTU\" && \"\$cur_hmtu\" == \"\$HOME_WIFI_MTU\" ]]"
    assert_ok "Standard Home Wi-Fi/LAN TCP MSS sysctls set to $HOME_WIFI_MSS IPv4 / $HOME_WIFI_V6MSS IPv6" \
      "[[ \"\$cur_mss\" == \"\$HOME_WIFI_MSS\" && \"\$cur_v6mss\" == \"\$HOME_WIFI_V6MSS\" ]]"
    assert_ok "Standard Home Wi-Fi/LAN keeps awdl0 UP for AirDrop/Handoff" \
      "/sbin/ifconfig awdl0 2>/dev/null | head -1 | grep -qw 'UP'"
    if [[ "$hdev_t" == "en9" ]]; then
      assert_ok "Active Wired Home LAN (en9) suppresses rogue 192.168.2.1 alias & bootpd DHCP server" \
        "! /sbin/ifconfig en9 2>/dev/null | grep -q 'inet 192\.168\.2\.1 ' && ! /usr/bin/pgrep -x bootpd >/dev/null 2>&1"
      assert_ok "Active Wired Home LAN (en9) has PF scrub max-mss $HOME_WIFI_MSS / $HOME_WIFI_V6MSS rules" \
        "grep -q 'scrub on en9 inet all max-mss 1452' \"\$SHAPER_STATE_FILE\" 2>/dev/null"
    else
      if iface_exists en9; then
        assert_ok "Attached en9 LAN interface is clean (upstream LAN without rogue bootpd or downstream 192.168.2.1)" \
          "/sbin/ifconfig en9 2>/dev/null | grep -qE 'inet (192\.168\.2\.1|192\.168\.15\.)' && ! /usr/bin/pgrep -x bootpd >/dev/null 2>&1"
      else
        assert_ok "Unplugged en9 USB LAN dongle cleanly detached & default route on Home Wi-Fi ($wdev)" \
          "! iface_exists en9 && [[ \"\$(default_route_device)\" == \"\$wdev\" ]]"
      fi
      assert_ok "Standard Home Wi-Fi ($wdev) has PF scrub max-mss $HOME_WIFI_MSS / $HOME_WIFI_V6MSS rules" \
        "grep -q \"scrub on \$wdev inet all max-mss 1452\" \"\$SHAPER_STATE_FILE\" 2>/dev/null"
    fi
  fi

  echo "✓ ${pass}/${total} live system & unit assertions passed (${fail} failed)"
  [[ $fail -eq 0 ]]
}

# --- Main --------------------------------------------------------------------

case "$MODE" in
  status) status ;;
  pf-status) pf_status ;;
  apply) apply; status ;;
  cap)
    echo "Updating hotspot cap to ${DOWN_MBPS} Mbps down / ${UP_MBPS} Mbps up…"
    apply
    status
    ;;
  unshape)
    SHAPE_ENABLED=0
    echo "Disabling bandwidth cap (keeping TCP/MSS/AWDL/QoS hotspot optimizations)…"
    apply
    status
    ;;
  shape)
    SHAPE_ENABLED=1
    echo "Enabling bandwidth cap (${DOWN_MBPS} Mbps down / ${UP_MBPS} Mbps up)…"
    apply
    status
    ;;
  restore) restore; status ;;
  pcap) pcap_audit "$PCAP_SECS" ;;
  owd-probe) owd_probe_cli ;;
  tail-mle) tail_mle_cli "${TAIL_MLE_ARGS[@]+"${TAIL_MLE_ARGS[@]}"}" ;;
  wireshark-gui) open_wireshark_gui ;;
  web|workbench) open_web_workbench "$WEB_ARG" ;;
  web-stop) stop_web_workbench ;;
  watchlist) show_watchlist ;;
  __emit_rules) emit_common_pf_tail "${EMIT_MSS:-$HOTSPOT_MSS}" ;;
  doctor) doctor_cli ;;
  version) version_cli ;;
  verify) verify_lean; run_self_tests ;;
  verify-lean) verify_lean ;;
  test|self-test) run_self_tests ;;
  menubar|menubar-start)
    launchctl enable "gui/$(id -u)/com.josaum.tether-menubar" 2>/dev/null || true
    launchctl bootout "gui/$(id -u)/com.josaum.tether-menubar" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "${MENUBAR_PLIST}" 2>/dev/null || true
    launchctl kickstart -k "gui/$(id -u)/com.josaum.tether-menubar"
    echo "Topbar widget started and enabled for OS autostart (com.josaum.tether-menubar)."
    ;;
  menubar-stop)
    launchctl bootout "gui/$(id -u)/com.josaum.tether-menubar" 2>/dev/null || true
    pkill -x tether-menubar 2>/dev/null || true
    echo "Topbar widget stopped."
    ;;
  watch) watch_loop ;;
  install-auto) install_auto ;;
  uninstall-auto) uninstall_auto ;;
  auto-status) auto_status ;;
  test-popup)
    notify_user "tether-optimize" "Wi-Fi & USB Personal Hotspot optimizer ready." Glass 1
    echo "Banner sent. Dongle status: $(usb_wifi_dongle_info)"
    ;;
  __root_apply)
    is_root || { echo "root required" >&2; exit 1; }
    ensure_state_dir
    apply_core
    ;;
  __root_restore)
    is_root || { echo "root required" >&2; exit 1; }
    ensure_state_dir
    restore_core
    ;;
  *) usage; exit 2 ;;
esac
