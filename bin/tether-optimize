#!/usr/bin/env bash
# tether-optimize — Smartphone & iPad Personal Hotspot Optimizer (Wi-Fi en0 + USB en7/en17).
#
# Keeps the hotspot host device (iPhone, iPad, or Android smartphone) fast and usable by:
#   1. Detecting both USB Personal Hotspots (iPhone USB en7, iPad USB en17, etc.) AND
#      Wi-Fi Personal Hotspots (en0 on 172.20.10.0/28, Android 192.168.43/49.x, or macOS
#      'constrained' Low Data Mode flag), with seamless handover between Wi-Fi and USB.
#   2. Clamping macOS TCP socket buffers (512 KB send / 1 MB recv instead of 16 MB), enabling
#      adaptive delayed ACKs (cutting reverse Wi-Fi ACK airtime in half), enabling L4S + ECN +
#      CUBIC fast convergence, and tightening LEDBAT++ background target queue delay to 15ms.
#   3. Shaping hotspot bandwidth via dummynet pipes (default: 25 Mbps down / 8 Mbps up, plus
#      dedicated 5/3 Mbps interactive fast lane for ICMP/DNS/SSH/NTP/DoT) so the Mac never
#      saturates the smartphone/iPad cellular baseband queue (bufferbloat).
#   4. Clamping TCP MSS to 1380 (IPv4 + IPv6) and setting MTU 1420 on the hotspot link to
#      prevent cellular packet fragmentation and PMTU stalls on the phone/iPad.
#   5. Disabling awdl0 (AirDrop/Handoff channel-hopping) while tethered over Wi-Fi hotspot so
#      neither the Mac nor the iPhone/iPad radio stutters, and restoring awdl0 automatically
#      when switching to USB tether or disconnecting.
#   6. Moving third-party background sync daemons (OneDrive, Adobe Creative Cloud / Core Sync,
#      Dropbox, updaters) into Darwin Background QoS (taskpolicy -b / LEDBAT++ scavenger
#      sockets) while tethered, and periodically sweeping newly spawned sync workers.
#
# Does NOT touch:
#   • Realtek 802.11n NIC (RTL8812AU / 0bda:8812) → VMware Fusion Ubuntu USB passthrough
#   • USB Ethernet docks (AX88179, en9 LAN segment, etc.)
#
set -euo pipefail

VERSION="1.1.2"
WIFI_OFF=0
SHAPE_ENABLED=1
DOWN_MBPS=${TETHER_DOWN_MBPS:-25}
UP_MBPS=${TETHER_UP_MBPS:-8}
HOTSPOT_MTU=1420
HOTSPOT_MSS=1380
OVERLAY_MSS=1220
HOME_WIFI_MTU=1492
HOME_WIFI_MSS=1452
HOME_WIFI_V6MSS=1432
HOME_OVERLAY_MSS=1332
TAILSCALE_DNS=""
MODE=apply
POLL_SECS=2
PCAP_SECS=4
LAST_PCAP_FILE="/tmp/tether-optimize-audit.pcapng"
WEB_ARG=""
WEB_WORKBENCH_PORT=""
EMIT_MSS=""

resolve_user_home() {
  if [[ -n "${TETHER_HOME:-}" && -d "${TETHER_HOME}" ]]; then
    printf '%s\n' "${TETHER_HOME}"
    return 0
  fi
  local cu
  cu=$(stat -f%Su /dev/console 2>/dev/null || true)
  if [[ -n "$cu" && "$cu" != "root" && "$cu" != "loginwindow" && -d "/Users/${cu}" ]]; then
    printf '%s\n' "/Users/${cu}"
    return 0
  fi
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" && -d "/Users/${SUDO_USER}" ]]; then
    printf '%s\n' "/Users/${SUDO_USER}"
    return 0
  fi
  if [[ -n "${HOME:-}" && "${HOME}" != "/var/root" && -d "${HOME}" ]]; then
    printf '%s\n' "${HOME}"
    return 0
  fi
  printf '%s\n' "/Users/josaum"
}

TETHER_USER_HOME="$(resolve_user_home)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT_PATH="${SCRIPT_DIR}/$(basename "$0")"
WIRESHARK_SKILL_DIR="${TETHER_WIRESHARK_SCRIPTS:-${TETHER_USER_HOME}/.gemini/config/skills/wireshark/scripts}"

LABEL="com.josaum.tether-optimize"
